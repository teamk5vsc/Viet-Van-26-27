# GEMINI_API_KEY: Server-side default Gemini API key (optional).
# If not set, the app falls back to an offline/simulated grading mode,
# or teachers can supply their own key via the Settings modal (sent as the
# x-api-key header to the /api/gemini/* routes — never used from the browser directly).
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this app is hosted (used for self-referential links).
APP_URL="http://localhost:3000"

# ADMIN_KEY: Required to access the /api/admin/* endpoints (usage dashboard).
# Set a long random value in your deployment environment (e.g. Vercel Project Settings).
# There is NO hard-coded default — the admin dashboard is inaccessible until this is set.
ADMIN_KEY="CHANGE_ME_TO_A_LONG_RANDOM_SECRET"

# KV_REST_API_URL / KV_REST_API_TOKEN: Vercel KV (or Upstash Redis) REST credentials
# used to persist class rosters and student submissions. If unset, the app falls back
# to writing local JSON files under ./data (fine for local dev, NOT persistent on Vercel).
KV_REST_API_URL=""
KV_REST_API_TOKEN=""
